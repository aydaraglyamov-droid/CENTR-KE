# Example .env (do NOT commit real secrets)

# Yandex Metrika
YANDEX_COUNTER_ID=12345678
YANDEX_OAUTH_TOKEN=ya29.example-token

# BandLink
BANDLINK_API_URL=https://api.band.link
BANDLINK_API_TOKEN=your_bandlink_token
BANDLINK_LINK_ID=HKtfe

# Artist
ARTIST_NAME="Казан Егетләре"
ARTIST_DESC="Краткое описание"

# Optional socials
SOCIAL_TELEGRAM=https://t.me/your_channel
SOCIAL_VK=https://vk.com/your_page
SOCIAL_YOUTUBE=https://youtube.com/your_channel
SOCIAL_INSTAGRAM=https://www.instagram.com/your_profile

# Spotify (PKCE)
SPOTIFY_CLIENT_ID=your_spotify_client_id
# Optional: client secret (NOT required for PKCE). If set, server will use Basic auth for token exchange
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
