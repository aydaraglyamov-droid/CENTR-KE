# ==========================================
# CENTR-KE Analytics Center — переменные окружения
# ==========================================
# Копируй в .env и заполни значения
# ВАЖНО: .env никогда не коммитится в Git

# ---------- Environment ----------
NODE_ENV=production
APP_VERSION=1.0.0

# ---------- BandLink (умная ссылка) ----------
BANDLINK_API_URL=https://api.band.link
BANDLINK_API_TOKEN=your_bandlink_api_token_here
BANDLINK_LINK_ID=HKtfe

# ---------- Яндекс.Метрика ----------
YANDEX_COUNTER_ID=98765432
YANDEX_OAUTH_TOKEN=your_yandex_oauth_token_here

# ---------- YouTube Data API v3 ----------
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=UCxxxxxxxx

# ---------- VK API ----------
VK_SERVICE_KEY=your_vk_service_key_here
VK_GROUP_ID=your_vk_group_id_here

# ---------- Telegram Bot API ----------
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_gHiJkLmNoPqRsTuVwXyZ
TELEGRAM_CHANNEL_ID=your_channel_id

# ---------- Spotify (PKCE) ----------
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ---------- Yandex Music ----------
YANDEX_MUSIC_ARTIST_ID=4160836

# ---------- Профиль артиста (опционально) ----------
ARTIST_NAME=Казан Егетлэре
ARTIST_DESC=Analytics Center для управления карьерой

# ---------- CORS Proxy (для server-side запросов) ----------
CORS_PROXY_ENABLED=true
CORS_PROXY_URL=https://api.allorigins.win/raw?url=

# ---------- Rate Limiting ----------
API_RATE_LIMIT=10
API_RATE_LIMIT_WINDOW=60000

# ---------- Logging ----------
DEBUG=false
LOG_LEVEL=info
